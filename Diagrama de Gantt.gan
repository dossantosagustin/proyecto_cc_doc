            <task id="8" uid="9e300a114b6c484ea4b676649b47a705" name="Estructura visual panel control" meeting="false" start="2026-07-17" duration="10" complete="0" expand="true">
                <notes><![CDATA[Se desarrolla un conjunto de normas visuales que garantizarán la coherencia estética de toda la plataforma. Se seleccionan colores institucionales, tipografías, estilos de botones, formularios, iconos y otros elementos gráficos. Esta guía servirá como referencia para mantener una identidad visual uniforme durante el desarrollo.
]]></notes>
                <depend id="9" type="2" difference="0" hardness="Strong"/>
            </task>
            <task id="9" uid="d5f98f991ace4b1c924cb742097d7738" name="Diseño final de interfaces" meeting="false" start="2026-07-31" duration="15" complete="0" expand="true">
                <notes><![CDATA[Una vez aprobada la estructura general, se desarrollan los diseños visuales definitivos de todas las pantallas. Se incorporan los colores, tipografías, imágenes y elementos gráficos definidos previamente. El resultado es una representación completa de cómo se verá la plataforma una vez desarrollada.]]></notes>
                <depend id="11" type="2" difference="0" hardness="Strong"/>
            </task>
            <task id="11" uid="4f62a84d95bb482381164b8b9b1d1628" name="Config. entorno y BD" meeting="false" start="2026-08-21" duration="20" complete="0" expand="true">
